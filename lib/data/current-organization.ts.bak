import { createSupabaseServerClient } from "@/lib/supabase/server";
import { requireUser } from "@/lib/auth/require-user";

export interface CurrentOrganization {
  id: string;
  name: string;
  slug: string;
  role: string;
}

export async function getCurrentOrganization(): Promise<CurrentOrganization> {
  const user = await requireUser();
  const supabase = await createSupabaseServerClient();

  const result = await (supabase as any)
    .from("organization_members")
    .select("role, organization_id, organizations(id, name, slug)")
    .eq("user_id", user.id)
    .eq("status", "active")
    .maybeSingle();

  const { data, error } = result;

  if (error) {
    throw new Error(`Unable to resolve the active organization: ${error.message}`);
  }

  if (!data?.organizations) {
    throw new Error("No active organization was found for this account.");
  }

  return {
    id: data.organization_id,
    name: data.organizations.name ?? "Untitled org",
    slug: data.organizations.slug ?? "untitled-org",
    role: data.role ?? "member",
  };
}
