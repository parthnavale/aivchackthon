export interface ThesisView {
  id: string;
  title: string;
  sectors: string[];
  stages: string[];
  geographies: string[];
  founderPatterns: string[];
  dealbreakers: string[];
  styleAnchors: string[];
  updatedAt: string;
  current: boolean;
}

export function mapThesisRow(row: {
  id: string;
  title: string | null;
  sectors: string[] | null;
  stages: string[] | null;
  geographies: string[] | null;
  founder_patterns: string[] | null;
  dealbreakers: string[] | null;
  style_anchors: string[] | null;
  updated_at: string | null;
  current: boolean | null;
}): ThesisView {
  return {
    id: row.id,
    title: row.title ?? "Venture thesis",
    sectors: row.sectors ?? [],
    stages: row.stages ?? [],
    geographies: row.geographies ?? [],
    founderPatterns: row.founder_patterns ?? [],
    dealbreakers: row.dealbreakers ?? [],
    styleAnchors: row.style_anchors ?? [],
    updatedAt: row.updated_at ?? new Date().toISOString(),
    current: row.current ?? false,
  };
}
